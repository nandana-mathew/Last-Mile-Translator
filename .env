# AWS Configuration
# Note: AWS_REGION is reserved by Lambda, use AWS_DEFAULT_REGION for local dev
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=last-mile-translator-bucket
DYNAMODB_DOCUMENTS_TABLE=government-documents
DYNAMODB_USERS_TABLE=user-profiles
DYNAMODB_METADATA_TABLE=policy-ingestion-metadata

# Textract Configuration
TEXTRACT_MAX_PAGES=100

# App Configuration
PORT=3000
NODE_ENV=production
DEMO_MODE=false
